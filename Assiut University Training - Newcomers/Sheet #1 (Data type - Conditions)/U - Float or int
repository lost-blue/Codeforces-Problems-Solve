#include<bits/stdc++.h>
using namespace std;
int main()
{
    float x;
    cin>>x;

    int y = ceil(x);

    if(x == y)
    {
        cout<<"int "<<(int)x<<endl;
    }
    else
    {
        cout<<"float "<<(int)x<<" ";
        cout<<fixed<<setprecision(3)<<(x-(int)x)<<endl;
    }

    return 0;
}
